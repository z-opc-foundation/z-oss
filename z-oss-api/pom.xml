            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/yuku123/z-oss.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/yuku123/z-oss.git</developerConnection>
        <url>https://github.com/yuku123/z-oss</url>
        <tag>HEAD</tag>
    </scm>


    <artifactId>z-oss-api</artifactId>
    <name>z-oss-api</name>
    <description>Z-OSS API: Spring Boot executable jar exposing REST endpoints (depends on z-oss-core).</description>

    <dependencies>
        <!-- Log4j2 API (本模块 src/main/java 含 LogManager.getLogger 调用) -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-oss-core</artifactId>
        </dependency>

        <!-- 2026-10-03: OssAdminController (自 z-opc main-starter 平移) 用
             z-ctc-sso 的 SsoContext/UserInfo 做操作人审计; z-util-core 的 Result 泛型容器
             (经 z-oss-core 传递已有, sso 需显式). provided: 作为库不绑死宿主的认证实现. -->
        <!--
          ⚠ 2026-10-22 (TASK-20261021-041): **显式钉 1.0.5**。
          原因: 父 pom z-boot-parent:1.1.0 把 <z-ctc.version> 钉在 **1.0.2**,
          而 1.0.2 里的 SsoInterceptor 没有「回跳协议取自 sso.login-url」这段逻辑
          (那是 z-ctc 仓 6050844 引入的, 见 SsoInterceptor#loginUrlScheme)。
          ⇒ 落回默认分支 ⇒ 登录回跳地址的协议被降级成 http:// (公网实测:
             GET https://oss.zopc.top/login → 302 Location 带 redirect=http://oss.zopc.top/login)。

          ⚠⚠ **为什么中央的 1.0.4 不管用**: Maven Central 上的 z-ctc-sso:1.0.4 是 **2026-10-17**
          构建的, **早于 10-21 00:52 的修复** ⇒ 那一版不含 loginUrlScheme。
          本地构建的 1.0.5 才含(实测字节里 loginUrlScheme 命中)。
          ⇒ 这是「中央构件 ≠ 线上构件」的又一例: **同版本号、不同内容**。
        -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-ctc-sso</artifactId>
            <version>1.0.5</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- knife4j-openapi3 由 z-oss 自行暴露 /doc.html；版本由父链供
             （地板按坐标供 knife4j-openapi3-* 4.1.0，与本仓迁移前同值） -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-spring-boot-starter</artifactId>
        </dependency>

        <!-- 测试台。此前本模块 0 支测试，下载/分片这些语义全靠编译过来说话 ——
             而 GET /api/v1/object 恰恰是"编译干净但返回 JSON"的那类缺陷。
             排掉 starter-logging：它会把 log4j2 事件灌进 slf4j→logback，
             方向正好和全仓 log4j2-only 的口径相反。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <!--
                              把可执行 jar 打成 exec 后缀的 classifier
                              这样原始的 z-oss-api-1.0.0.jar 是普通 jar，可作为依赖被引用
                            -->
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 父 pom 的 surefire 默认只收 **/*Test.java，*IT.java 会被静默跳过；
                 ZossDeployedServiceIT 打的是真实部署实例，不能默认漏掉。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>